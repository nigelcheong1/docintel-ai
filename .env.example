DOCINTEL_APP_NAME=DocIntel AI API
DOCINTEL_DATABASE_URL=postgresql+psycopg://docintel:docintel@localhost:5432/docintel
DOCINTEL_STORAGE_DIR=storage
DOCINTEL_MAX_UPLOAD_MB=20
DOCINTEL_EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
DOCINTEL_EMBEDDING_DIMENSION=384
DOCINTEL_EMBEDDING_DEVICE=cpu
DOCINTEL_LLM_PROVIDER=local
DOCINTEL_OCR_ENABLED=true
DOCINTEL_OCR_LANGUAGE=eng
DOCINTEL_OCR_DPI=200
DOCINTEL_OCR_MAX_PAGES=25
DOCINTEL_OCR_PAGE_TIMEOUT_SECONDS=20
DOCINTEL_BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
# Optional local executable when Tesseract is not on PATH:
# DOCINTEL_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# Optional hosted generation for summaries/study sets, not Verified Answers:
# DOCINTEL_LLM_PROVIDER=groq
# DOCINTEL_GROQ_API_KEY=
# DOCINTEL_LLM_MODEL_NAME=llama-3.1-8b-instant
# NEXT_PUBLIC_API_BASE_URL must also be set in the frontend shell or apps/web/.env.local.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
